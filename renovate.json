{
  "extends": [
    ":separateMajor",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "groupName": "VitePress core",
      "matchPackageNames": ["vitepress", "@types/node"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "VitePress plugins",
      "matchPackageNames": ["vite-plugin-compression2", "vitepress-sidebar"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ],
  "timezone": "Europe/Tallinn",
  "schedule": ["after 5pm on the first day of the month"],
  "rangeStrategy": "bump",
  "reviewers": ["tomkabel"],
  "branchPrefix": "renovate/",
  "labels": ["dependencies"]
}
